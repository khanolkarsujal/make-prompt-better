{
  "name": "vibe-prompt-engine",
  "displayName": "Vibe Prompt Engine",
  "description": "Intelligent prompt orchestration for AI coding tools - analyze, clarify, and enhance your prompts",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vibePromptEngine.enhancePrompt",
        "title": "Vibe Prompt Engine: Enhance Current Prompt"
      },
      {
        "command": "vibePromptEngine.showSidebar",
        "title": "Vibe Prompt Engine: Show Sidebar"
      }
    ],
    "keybindings": [
      {
        "command": "vibePromptEngine.enhancePrompt",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vibePromptEngine",
          "title": "Vibe Prompt Engine",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "vibePromptEngine": [
        {
          "id": "vibePromptEngine.sidebar",
          "name": "Prompt Enhancer",
          "type": "webview",
          "icon": "$(rocket)"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test",
    "package": "vsce package"
  },
  "dependencies": {
    "axios": "^1.16.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3"
  }
}
