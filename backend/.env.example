# Vibe Prompt Engine - Environment Variables Example
# Copy this file to .env and fill in your actual values.
# NEVER commit your actual .env file to version control.

# Set the AI Provider you want to use. Options: 'anthropic' or 'xai'
AI_PROVIDER=anthropic

# If using Anthropic (Claude), provide your API key here:
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# If using xAI (Grok), provide your API key here:
XAI_API_KEY=your_xai_api_key_here
